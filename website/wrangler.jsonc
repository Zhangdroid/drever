{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "drever-website",
  "compatibility_date": "2026-07-22",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./build/client",
    "not_found_handling": "single-page-application",
  },
  "routes": [
    {
      "pattern": "drever.dev",
      "custom_domain": true,
    },
  ],
}
