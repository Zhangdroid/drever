{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "module": "nodenext",
    "moduleDetection": "force",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "drever": ["./packages/cli/src/index.ts"],
      "drever/create": ["./packages/cli/src/create.ts"],
      "@drever/brand": ["./packages/brand/src/index.ts"],
      "@drever/client": ["./packages/client/src/index.ts"],
      "@drever/compiler": ["./packages/compiler/src/index.ts"],
      "@drever/compiler/internal": ["./packages/compiler/src/internal.ts"],
      "@drever/core": ["./packages/core/src/index.ts"],
      "@drever/plugin": ["./packages/plugin/src/index.ts"],
      "@drever/plugin-math": ["./packages/plugin-math/src/index.ts"],
      "@drever/plugin-shiki": ["./packages/plugin-shiki/src/index.ts"],
      "@drever/plugin-tailwindcss": ["./packages/plugin-tailwindcss/src/index.ts"],
      "@drever/scenes": ["./packages/scenes/src/index.ts"],
      "@drever/schema": ["./packages/schema/src/index.ts"],
      "@drever/theme-atlas": ["./packages/theme-atlas/src/index.ts"],
      "@drever/theme-atlas/layouts": ["./packages/theme-atlas/src/layouts.tsx"],
      "@drever/theme-cinema": ["./packages/theme-cinema/src/index.ts"],
      "@drever/theme-cinema/layouts": ["./packages/theme-cinema/src/layouts.tsx"],
      "@drever/theme-construct": ["./packages/theme-construct/src/index.ts"],
      "@drever/theme-construct/layouts": ["./packages/theme-construct/src/layouts.tsx"],
      "@drever/theme-default": ["./packages/theme-default/src/index.ts"],
      "@drever/theme-default/layouts": ["./packages/theme-default/src/layouts.tsx"],
      "@drever/theme-editorial": ["./packages/theme-editorial/src/index.ts"],
      "@drever/theme-editorial/layouts": ["./packages/theme-editorial/src/layouts.tsx"],
      "@drever/theme-fieldnote": ["./packages/theme-fieldnote/src/index.ts"],
      "@drever/theme-fieldnote/layouts": ["./packages/theme-fieldnote/src/layouts.tsx"],
      "@drever/theme-ledger": ["./packages/theme-ledger/src/index.ts"],
      "@drever/theme-ledger/layouts": ["./packages/theme-ledger/src/layouts.tsx"],
      "@drever/theme-studio": ["./packages/theme-studio/src/index.ts"],
      "@drever/theme-studio/layouts": ["./packages/theme-studio/src/layouts.tsx"],
      "@drever/vite": ["./packages/vite/src/index.ts"]
    },
    "skipLibCheck": true,
    "strict": true,
    "target": "esnext",
    "verbatimModuleSyntax": true
  }
}
