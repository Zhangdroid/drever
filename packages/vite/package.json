  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "test": "vp test"
  },
  "dependencies": {
    "@drever/compiler": "workspace:*",
    "@drever/core": "workspace:*",
    "@drever/plugin": "workspace:*",
    "@drever/schema": "workspace:*",
    "@mdx-js/rollup": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "unified": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "vite": "^8.0.0 || 0.2.5"
  },
  "engines": {
    "node": ">=24.18.0"
  }
}
