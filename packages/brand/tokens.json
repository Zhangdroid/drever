{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Canonical Drever brand primitives. Product and theme semantics are mapped by consumers.",
  "color": {
    "$type": "color",
    "ink": {
      "$description": "Primary mark, text, and high-contrast surface color.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.098039, 0.090196, 0.168627],
        "hex": "#19172B"
      }
    },
    "paper": {
      "$description": "Warm presentation and documentation canvas.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.964706, 0.952941, 0.913725],
        "hex": "#F6F3E9"
      }
    },
    "white": {
      "$description": "Neutral white for compact contrast and compositing.",
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "hex": "#FFFFFF"
      }
    },
    "signal": {
      "$description": "Brand signal for motion, state change, and editorial emphasis.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.780392, 0.941176, 0.227451],
        "hex": "#C7F03A"
      }
    },
    "signalSoft": {
      "$description": "Quiet signal surface. Use ink foreground text.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.92549, 0.972549, 0.776471],
        "hex": "#ECF8C6"
      }
    },
    "continuity": {
      "$description": "Interactive, navigational, and continuity accent, secondary to signal in brand expression.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.356863, 0.270588, 0.847059],
        "hex": "#5B45D8"
      }
    },
    "continuitySoft": {
      "$description": "Quiet continuity surface. Use ink foreground text.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.913725, 0.894118, 1],
        "hex": "#E9E4FF"
      }
    },
    "graphite": {
      "$description": "Secondary text and neutral icon color on light surfaces.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.407843, 0.392157, 0.454902],
        "hex": "#686474"
      }
    },
    "line": {
      "$description": "Low-emphasis boundaries on light surfaces.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.85098, 0.831373, 0.882353],
        "hex": "#D9D4E1"
      }
    },
    "night": {
      "$description": "Primary dark canvas.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.066667, 0.062745, 0.094118],
        "hex": "#111018"
      }
    },
    "nightSurface": {
      "$description": "Raised surface on the dark canvas.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.113725, 0.101961, 0.164706],
        "hex": "#1D1A2A"
      }
    },
    "nightLine": {
      "$description": "Low-emphasis boundaries on dark surfaces.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.227451, 0.207843, 0.286275],
        "hex": "#3A3549"
      }
    },
    "nightText": {
      "$description": "Primary foreground on dark surfaces.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.964706, 0.952941, 0.913725],
        "hex": "#F6F3E9"
      }
    },
    "nightMuted": {
      "$description": "Secondary foreground on dark surfaces.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.72549, 0.701961, 0.780392],
        "hex": "#B9B3C7"
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": {
        "$value": [
          "Bricolage Grotesque",
          "Instrument Sans",
          "PingFang SC",
          "Hiragino Sans GB",
          "Microsoft YaHei",
          "sans-serif"
        ]
      },
      "sans": {
        "$value": [
          "Instrument Sans",
          "PingFang SC",
          "Hiragino Sans GB",
          "Microsoft YaHei",
          "sans-serif"
        ]
      },
      "mono": {
        "$value": ["SFMono-Regular", "Cascadia Code", "Roboto Mono", "ui-monospace", "monospace"]
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 520 },
      "semibold": { "$value": 650 },
      "bold": { "$value": 700 }
    },
    "width": {
      "$description": "Variable font width-axis percentages. Brand typography uses natural width by default.",
      "$type": "number",
      "display": { "$value": 100 },
      "compact": { "$value": 100 },
      "text": { "$value": 100 }
    },
    "lineHeight": {
      "$type": "number",
      "display": { "$value": 0.92 },
      "heading": { "$value": 1.04 },
      "body": { "$value": 1.5 }
    },
    "tracking": {
      "$description": "Unitless em multipliers. Multiply by 1em when assigning letter-spacing.",
      "$type": "number",
      "display": { "$value": -0.03 },
      "heading": { "$value": -0.02 },
      "body": { "$value": -0.012 },
      "label": { "$value": 0.1 }
    }
  },
  "geometry": {
    "$description": "Signature Stage / Signal / Shift geometry.",
    "$type": "dimension",
    "shift": { "$value": { "value": 0.75, "unit": "rem" } },
    "signalRail": { "$value": { "value": 0.125, "unit": "rem" } },
    "signalBand": { "$value": { "value": 0.75, "unit": "rem" } }
  },
  "space": {
    "$type": "dimension",
    "zero": { "$value": { "value": 0, "unit": "px" } },
    "one": { "$value": { "value": 0.25, "unit": "rem" } },
    "two": { "$value": { "value": 0.5, "unit": "rem" } },
    "three": { "$value": { "value": 0.75, "unit": "rem" } },
    "four": { "$value": { "value": 1, "unit": "rem" } },
    "six": { "$value": { "value": 1.5, "unit": "rem" } },
    "eight": { "$value": { "value": 2, "unit": "rem" } },
    "twelve": { "$value": { "value": 3, "unit": "rem" } },
    "sixteen": { "$value": { "value": 4, "unit": "rem" } },
    "twentyFour": { "$value": { "value": 6, "unit": "rem" } }
  },
  "radius": {
    "$type": "dimension",
    "zero": { "$value": { "value": 0, "unit": "px" } },
    "small": { "$value": { "value": 0.5, "unit": "rem" } },
    "medium": { "$value": { "value": 0.875, "unit": "rem" } },
    "large": { "$value": { "value": 1.25, "unit": "rem" } },
    "xlarge": { "$value": { "value": 2, "unit": "rem" } },
    "full": { "$value": { "value": 999, "unit": "px" } }
  },
  "stroke": {
    "$type": "dimension",
    "hairline": { "$value": { "value": 1, "unit": "px" } },
    "strong": { "$value": { "value": 2, "unit": "px" } }
  },
  "material": {
    "$description": "Reference values for Iris Glass floating product chrome. Consumers own the semantic color recipe.",
    "irisGlass": {
      "blur": {
        "$type": "dimension",
        "$value": { "value": 1.125, "unit": "rem" }
      },
      "saturation": { "$type": "number", "$value": 1.35 },
      "surfaceOpacity": { "$type": "number", "$value": 0.72 },
      "overlayOpacity": { "$type": "number", "$value": 0.88 }
    }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "instant": { "$value": { "value": 120, "unit": "ms" } },
      "quick": { "$value": { "value": 180, "unit": "ms" } },
      "standard": { "$value": { "value": 320, "unit": "ms" } },
      "expressive": { "$value": { "value": 520, "unit": "ms" } }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.22, 1, 0.36, 1] },
      "emphasized": { "$value": [0.16, 1, 0.3, 1] },
      "exit": { "$value": [0.4, 0, 1, 1] }
    }
  }
}
