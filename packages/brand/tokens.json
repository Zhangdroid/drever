{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Canonical Drever brand primitives. Product and theme semantics are mapped by consumers.",
  "color": {
    "$type": "color",
    "ink": {
      "$description": "Primary mark, text, and high-contrast surface color.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.090196, 0.12549, 0.2],
        "hex": "#172033"
      }
    },
    "paper": {
      "$description": "Warm presentation and documentation canvas.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.972549, 0.972549, 0.956863],
        "hex": "#F8F8F4"
      }
    },
    "white": {
      "$description": "Neutral white for compact contrast and compositing.",
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "hex": "#FFFFFF"
      }
    },
    "coral": {
      "$description": "Brand signal for motion, state change, and editorial emphasis.",
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 0.439216, 0.301961],
        "hex": "#FF704D"
      }
    },
    "coralSoft": {
      "$description": "Quiet coral surface. Use ink foreground text.",
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 0.894118, 0.862745],
        "hex": "#FFE4DC"
      }
    },
    "indigo": {
      "$description": "Interactive and technical accent, secondary to coral in brand expression.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.294118, 0.337255, 0.909804],
        "hex": "#4B56E8"
      }
    },
    "indigoSoft": {
      "$description": "Quiet indigo surface. Use ink foreground text.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.898039, 0.905882, 1],
        "hex": "#E5E7FF"
      }
    },
    "graphite": {
      "$description": "Secondary text and neutral icon color on light surfaces.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.4, 0.439216, 0.521569],
        "hex": "#667085"
      }
    },
    "line": {
      "$description": "Low-emphasis boundaries on light surfaces.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.85098, 0.866667, 0.905882],
        "hex": "#D9DDE7"
      }
    },
    "night": {
      "$description": "Primary dark canvas.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.05098, 0.062745, 0.098039],
        "hex": "#0D1019"
      }
    },
    "nightSurface": {
      "$description": "Raised surface on the dark canvas.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.094118, 0.109804, 0.168627],
        "hex": "#181C2B"
      }
    },
    "nightLine": {
      "$description": "Low-emphasis boundaries on dark surfaces.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.207843, 0.227451, 0.309804],
        "hex": "#353A4F"
      }
    },
    "nightText": {
      "$description": "Primary foreground on dark surfaces.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.972549, 0.972549, 0.956863],
        "hex": "#F8F8F4"
      }
    },
    "nightMuted": {
      "$description": "Secondary foreground on dark surfaces.",
      "$value": {
        "colorSpace": "srgb",
        "components": [0.682353, 0.709804, 0.776471],
        "hex": "#AEB5C6"
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Instrument Sans",
          "PingFang SC",
          "Hiragino Sans GB",
          "Microsoft YaHei",
          "sans-serif"
        ]
      },
      "mono": {
        "$value": ["SFMono-Regular", "Cascadia Code", "Roboto Mono", "ui-monospace", "monospace"]
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 520 },
      "semibold": { "$value": 650 },
      "bold": { "$value": 700 }
    },
    "width": {
      "$description": "Instrument Sans width-axis percentages.",
      "$type": "number",
      "display": { "$value": 82 },
      "compact": { "$value": 88 },
      "text": { "$value": 100 }
    },
    "lineHeight": {
      "$type": "number",
      "display": { "$value": 0.92 },
      "heading": { "$value": 1.04 },
      "body": { "$value": 1.5 }
    },
    "tracking": {
      "$description": "Unitless em multipliers. Multiply by 1em when assigning letter-spacing.",
      "$type": "number",
      "display": { "$value": -0.055 },
      "heading": { "$value": -0.035 },
      "body": { "$value": -0.012 },
      "label": { "$value": 0.1 }
    }
  },
  "space": {
    "$type": "dimension",
    "zero": { "$value": { "value": 0, "unit": "px" } },
    "one": { "$value": { "value": 0.25, "unit": "rem" } },
    "two": { "$value": { "value": 0.5, "unit": "rem" } },
    "three": { "$value": { "value": 0.75, "unit": "rem" } },
    "four": { "$value": { "value": 1, "unit": "rem" } },
    "six": { "$value": { "value": 1.5, "unit": "rem" } },
    "eight": { "$value": { "value": 2, "unit": "rem" } },
    "twelve": { "$value": { "value": 3, "unit": "rem" } },
    "sixteen": { "$value": { "value": 4, "unit": "rem" } },
    "twentyFour": { "$value": { "value": 6, "unit": "rem" } }
  },
  "radius": {
    "$type": "dimension",
    "zero": { "$value": { "value": 0, "unit": "px" } },
    "small": { "$value": { "value": 0.5, "unit": "rem" } },
    "medium": { "$value": { "value": 0.875, "unit": "rem" } },
    "large": { "$value": { "value": 1.25, "unit": "rem" } },
    "xlarge": { "$value": { "value": 2, "unit": "rem" } },
    "full": { "$value": { "value": 999, "unit": "px" } }
  },
  "stroke": {
    "$type": "dimension",
    "hairline": { "$value": { "value": 1, "unit": "px" } },
    "strong": { "$value": { "value": 2, "unit": "px" } }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "instant": { "$value": { "value": 120, "unit": "ms" } },
      "quick": { "$value": { "value": 180, "unit": "ms" } },
      "standard": { "$value": { "value": 320, "unit": "ms" } },
      "expressive": { "$value": { "value": 520, "unit": "ms" } }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.22, 1, 0.36, 1] },
      "emphasized": { "$value": [0.16, 1, 0.3, 1] },
      "exit": { "$value": [0.4, 0, 1, 1] }
    }
  }
}
