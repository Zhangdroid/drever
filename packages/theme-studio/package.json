{
  "name": "@drever/theme-studio",
  "version": "0.0.0",
  "description": "A focused dark studio theme for technical and product presentations in Drever.",
  "license": "MIT",
  "files": [
    "dist",
    "theme.css"
  ],
  "type": "module",
  "sideEffects": [
    "./theme.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./layouts": {
      "types": "./dist/layouts.d.mts",
      "import": "./dist/layouts.mjs"
    },
    "./theme.css": "./theme.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "test": "vp test"
  },
  "dependencies": {
    "@drever/compiler": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:"
  },
  "engines": {
    "node": ">=24.18.0"
  }
}
