{
  "name": "@drever/plugin-charts",
  "version": "0.0.0",
  "description": "Accessible, deterministic SVG charts for Drever presentations.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zhangdroid/drever.git",
    "directory": "packages/plugin-charts"
  },
  "files": [
    "dist",
    "README.md",
    "styles.css"
  ],
  "type": "module",
  "sideEffects": [
    "./styles.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./data-chart": {
      "types": "./dist/data-chart.d.mts",
      "import": "./dist/data-chart.mjs"
    },
    "./animated-number": {
      "types": "./dist/animated-number.d.mts",
      "import": "./dist/animated-number.mjs"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "test": "vp test"
  },
  "dependencies": {
    "@drever/compiler": "workspace:*",
    "@drever/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:"
  },
  "engines": {
    "node": ">=24.18.0"
  }
}
