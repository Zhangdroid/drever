{
  "name": "@drever/client",
  "version": "0.0.0",
  "description": "Modern-browser viewer runtime for Drever presentations.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zhangdroid/drever.git",
    "directory": "packages/client"
  },
  "files": [
    "dist",
    "studio.css",
    "storyboard.css",
    "styles.css"
  ],
  "type": "module",
  "sideEffects": [
    "./studio.css",
    "./storyboard.css",
    "./styles.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./audience": {
      "types": "./dist/audience.d.mts",
      "import": "./dist/audience.mjs"
    },
    "./document": {
      "types": "./dist/document.d.mts",
      "import": "./dist/document.mjs"
    },
    "./speaker": {
      "types": "./dist/speaker.d.mts",
      "import": "./dist/speaker.mjs"
    },
    "./storyboard": {
      "types": "./dist/storyboard.d.mts",
      "import": "./dist/storyboard.mjs"
    },
    "./studio": {
      "types": "./dist/studio.d.mts",
      "import": "./dist/studio.mjs"
    },
    "./studio-thumbnail": {
      "types": "./dist/studio-thumbnail.d.mts",
      "import": "./dist/studio-thumbnail.mjs"
    },
    "./studio.css": "./studio.css",
    "./storyboard.css": "./storyboard.css",
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "test": "vp test"
  },
  "dependencies": {
    "@drever/brand": "workspace:*",
    "@drever/core": "workspace:*",
    "@drever/schema": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "engines": {
    "node": ">=24.18.0"
  }
}
