{
  "name": "@drever/plugin-gfm",
  "version": "0.0.0",
  "description": "GitHub Flavored Markdown support for Drever.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zhangdroid/drever.git",
    "directory": "packages/plugin-gfm"
  },
  "files": [
    "dist",
    "README.md",
    "styles.css"
  ],
  "type": "module",
  "sideEffects": [
    "./styles.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./styles.css": "./styles.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "test": "vp test"
  },
  "dependencies": {
    "@drever/compiler": "workspace:*",
    "@drever/plugin": "workspace:*",
    "@drever/schema": "workspace:*",
    "remark-gfm": "catalog:",
    "unified": "catalog:"
  },
  "devDependencies": {
    "@types/mdast": "catalog:",
    "@types/node": "catalog:",
    "remark-parse": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.18.0"
  }
}
