{
  "name": "drever",
  "version": "0.0.0",
  "description": "The AI-first MDX presentation command line for Drever.",
  "license": "MIT",
  "bin": {
    "drever": "./dist/bin.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "test": "vp test"
  },
  "dependencies": {
    "@drever/client": "workspace:*",
    "@drever/compiler": "workspace:*",
    "@drever/core": "workspace:*",
    "@drever/plugin-shiki": "workspace:*",
    "@drever/plugin-tailwindcss": "workspace:*",
    "@drever/schema": "workspace:*",
    "@drever/theme-default": "workspace:*",
    "@drever/vite": "workspace:*",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vite": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24.18.0"
  }
}
